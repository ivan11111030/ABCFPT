# Example Environment Variables for Professional Streaming Setup

# OBS Studio WebSocket Configuration
OBS_HOST=localhost
OBS_PORT=4444
OBS_PASSWORD=

# Server Port
PORT=4000

# Socket Server URL (for production deployment)
SOCKET_SERVER_URL=http://localhost:4000

# Facebook Live / RTMP Configuration
# ⚠️ KEEP THESE SECRET - NEVER COMMIT TO GIT ⚠️
FACEBOOK_RTMP_URL=rtmp://live-api.facebook.com:80/rtmp/
FACEBOOK_STREAM_KEY=your_stream_key_here

# NDI Runtime (if using NDI cameras)
NDI_RUNTIME_PATH=/path/to/ndi/runtime

# Encoding Defaults
DEFAULT_ENCODING_PROFILE=medium

# Socket server auth (optional but recommended — see docs/DEPLOYMENT.md
# "Securing the socket server". Without this, the socket server accepts
# operator commands from anyone who can reach it.
FIREBASE_SERVICE_ACCOUNT_KEY=

# Firebase (optional — only needed to point the app at a different Firebase
# project than the built-in abcf-pt default; these are safe to be public)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
